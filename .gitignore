node_modules/
frontend/dist/
.env
var/
.DS_Store

# Python tooling caches (conformance suite venv + pytest)
.venv/
__pycache__/
.pytest_cache/

# Local config / secrets — only the *.example is tracked.
oc.toml
oc.lock
*.secret
*.pem
*.key
*_token*
*.bak

# bin/ci.sh's per-working-copy mutex (T-70c9). Lives inside the clone ON PURPOSE
# — that is what makes it a per-copy lock rather than a machine-global one — so
# it must be ignored, or every CI run would stamp its own provenance line DIRTY.
.ci-lock/

# Agent scratch/debug dir — never commit
scratchpad/
# Agent quarantine dir for removed files (deletes go here, never `rm`)
trash/

# M4 deploy artifact (SPA-embedded ocserverd built by bin/build) — never commit
.deploy/
cli/ocagent/ocagent
cli/ocwarden/ocwarden
cli/officraft/officraft
cli/ocwarden/ocwarden.prev
cli/ocwarden/ocagent
cli/ocwarden/ocagent.prev

# Release pipeline artifacts (bin/release) — never commit
/dist/*
!/dist/officraft/
!/dist/officraft/officraft
!/dist/officraft/source.sha256
!/dist/officraft/binary.sha256
!/dist/officraft/BUILD.md

# seven_gate run artifacts (e2e_test/seven_gate/run.sh) — one directory per run,
# kept on disk on purpose (log + journal + verdict) and never committed.
e2e_test/seven_gate/runs/

#!/usr/bin/env bash
# officraft — stage the prebuilt binaries + frozen MCP catalog for the
# single binary.
#
# bootstrap-here / the binary download routes / MCP tools/list serve three
# repo-file assets (bin/ocwarden, bin/ocagent, spec/mcp-catalog.json)
# EMBED-ONLY (assets.go + api_machines.go — no disk fallback, so a stale copy
# under the CWD can never shadow the embed the binary was built with). go:embed
# cannot reach outside the server module, so this stages them into
# server/ocserverd/bindist/ (gitignored except .gitkeep) before `go build` —
# the exact seedsdist pattern (bin/build-seedsdist). WITHOUT this staging the
# binary still builds but serves an EMPTY bindist embed (tools/list, the binary
# downloads, and bootstrap-here all fail).
#
# ocwarden/ocagent are built FRESH here for the server's own GOOS/GOARCH
# (single platform on purpose: bootstrap-here installs on the server host
# itself, which is by definition the same platform; cross-platform remote
# installs still need the on-disk bin/ artifacts). Chicken-and-egg ordering:
# this MUST run before the ocserverd build that embeds it.
#
#   bash bin/build-bindist            # stage ocwarden + ocagent + catalog
#   (cd server/ocserverd && go build) # then bakes them into the binary
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# 🔴 RESOLVED BEFORE ANYTHING IS DELETED. The wipe below removes a TRACKED file
# (server/ocserverd/bindist/.gitkeep), so a sha check placed after it left the
# working tree with that file deleted and only an error message to explain it.
# Nothing destructive happens until we know this build can name itself.
OCAGENT_SHA="${OCAGENT_SHA:-$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)}"
# Trim before testing: `-z` is false for " ", and a whitespace stamp links in
# cleanly, produces a binary that passes every text check, and prints no segment
# at runtime — the unstamped fleet again, wearing a value.
OCAGENT_SHA="$(printf '%s' "$OCAGENT_SHA" | tr -d '[:space:]')"
if [[ -z "$OCAGENT_SHA" ]]; then
  echo "build-bindist: cannot resolve a git sha for the ocagent stamp (is this a" >&2
  echo "  git checkout? a tarball or 'git archive' tree has no .git). Refusing to" >&2
  echo "  build an ocagent that cannot say which build it is: an unstamped listener" >&2
  echo "  is indistinguishable from a dev build, which is the false negative this" >&2
  echo "  stamp exists to remove. Set OCAGENT_SHA explicitly to build anyway." >&2
  exit 1
fi

BINDIST="$ROOT/server/ocserverd/bindist"
rm -rf "$BINDIST"
mkdir -p "$BINDIST"
# 🔴 ocagent CARRIES ITS BUILD SHA; the other two deliberately do NOT.
# A listener process holds the image it started with. Measured on this fleet:
# one listener sat on inode 65557770 while the file on disk turned over four
# times (65845892 → 66185238 → 66321537) — so a FIXED bug is, for every
# long-lived agent, unfixed until it restarts, and "ship it and watch the fleet
# get better" returns a false negative. T-5b83 lost two generations to exactly
# that, both nearly concluding cloudflared was stripping a header. Without a
# stamp the only way to know which ocagent a listener runs is lsof from outside.
#
# ⚠️ NOT cli/officraft (below): its -trimpath -buildvcs=false exist precisely to
# keep the git revision OUT of the bits (dist/officraft/BUILD.md), because that
# binary is the ONE committed prebuilt whose bytes are compared.
#
# 🔴 AND NOTHING THAT EXISTED BEFORE WOULD HAVE CAUGHT IT. An earlier version of
# this comment claimed stamping all three makes check-officraft-dist go rc=1 with
# `stale: cli/officraft source hash`. That is FALSE — I measured it: rc=0, no
# output. check-officraft-dist hashes cli/officraft's SOURCE files and
# dist/officraft/officraft's bytes; it never reads this script and never looks at
# server/ocserverd/bindist/officraft, so stamping — which changes no source file —
# is invisible to it. What actually happens is worse than the wrong claim: the
# SHIPPED anchor silently diverges from the committed one (measured: bindist copy
# 710a2525… → d8fb53dd… under the stamp, while dist/officraft/officraft and
# binary.sha256 both stay 710a2525…), and the embedded copy is what every install
# receives. bin/tests/agent-build-sha-guard.sh check 4 is the ONLY thing in the
# tree that catches it.
# ocwarden is not a listener and needs none. -s -w strips symbols and DWARF,
# neither of which -X uses, so stamping costs no strip.
#
# 🔴 NO SHA ⇒ DIE, never an empty stamp. `|| echo ''` here was a silent downgrade
# to a completely unstamped fleet: measured on a tree unpacked with `git archive`
# (no .git at all — the shape of a source tarball build), the build succeeded, the
# guard printed 6 ok, and the real listener printed no [agent …] segment at all.
# That is the exact false negative this whole feature exists to kill, reinstated by
# a fallback nobody would look at. A build that cannot name itself must not ship.
(cd "$ROOT/cli/ocagent" && go build -ldflags="-s -w -X main.buildSHA=$OCAGENT_SHA" -o "$BINDIST/ocagent" ./...)
# The anchor is built BEFORE ocwarden and staged into cli/ocwarden/anchordist,
# because ocwarden embeds it: the cockpit's one-liner downloads ocwarden alone,
# and `ocwarden install` refuses without an anchor. Staging into both places
# from ONE build is what keeps the embedded copy, the tarball copy and the
# committed dist/officraft byte-identical — three different builds would be
# three different TCC identities and three separate authorization prompts.
#
# -trimpath -buildvcs=false: TCC identifies an ad-hoc signed binary by the hash
# of its bytes. Both flags are load-bearing — -trimpath keeps the build
# directory out of the bytes, and -buildvcs=false keeps the git revision and the
# dirty-tree flag out (without it the anchor's bytes change on every commit, and
# building the same source twice from different checkouts gives two different
# identities). dist/officraft/BUILD.md builds the committed reference copy with
# exactly these flags.
ANCHORDIST="$ROOT/cli/ocwarden/anchordist"
mkdir -p "$ANCHORDIST"
(cd "$ROOT/cli/officraft" && go build -trimpath -buildvcs=false -ldflags="-s -w" -o "$BINDIST/officraft" ./...)
cp "$BINDIST/officraft" "$ANCHORDIST/officraft"
touch "$ANCHORDIST/.gitkeep"

# ocwarden LAST of the two, so its embed picks up the anchor staged just above.
(cd "$ROOT/cli/ocwarden" && go build -ldflags="-s -w" -o "$BINDIST/ocwarden" ./...)
# THE FLEET-SERVED BINARIES ARE NOT CODE-SIGNED, and this script has no way to
# sign them (T-0398, owner 2026-07-31). They carry whatever `go build` produces —
# an adhoc signature with a fresh cdhash per build. The signing machinery is
# DELETED rather than switched off, escape hatch included, so this script needs no
# keychain and concurrent bin/ci.sh runs cannot contend for one. ⚠️ This is NOT
# the same subject as the TCC identity anchor above: the anchor is recognised by
# its BYTES (which is why it is byte-pinned and never overwritten), and that
# mechanism never depended on a signing identity.
cp "$ROOT/spec/mcp-catalog.json" "$BINDIST/"
touch "$BINDIST/.gitkeep"
echo "[build-bindist] staged ocwarden (anchor embedded) + ocagent + officraft + mcp-catalog.json → server/ocserverd/bindist"
